#!/usr/bin/env python3
"""esp32-test: quick CLI evaluation of the ESP32-C5 OBU over the obu_comm wire protocol (USB).

Cross-platform (Linux, Windows 11): needs Python 3.8+ and pyserial (`pip install pyserial`).
On Windows run as `python tools\\esp32-test ...`.
"""
from __future__ import annotations

import argparse
import json
import struct
import sys
import time

try:
    import serial
    import serial.tools.list_ports
except ImportError:
    sys.exit("pyserial missing: pip install pyserial")

# ── obu_comm wire protocol (main/obu_comm.h), all fields big-endian ──────────
COMM_MAGIC = 0x7384
COMM_HDR = struct.Struct(">HHHH")          # magic, seqNo, type, length
COMM_FRAME_HDR_LEN = 16                    # sizeof(CommFrameHeader) prefixing each RX payload
CBR_IND = struct.Struct(">IIII")           # avg/latest milli-percent, valid/rejected samples

PING, PONG = 1, 2
CMD_REBOOT, CMD_CONFIG, CMD_START, CMD_STOP = 20, 21, 22, 23
CMD_GOOD, CMD_FAIL = 28, 29
FRAME_RX = 30
CMD_CBR_READ, CBR_IND_FRAME = 50, 53
TX_LOOP_START, TX_LOOP_STOP, TX_LOOP_STATUS = 60, 61, 62
FW_BEGIN, FW_DATA, FW_END, FW_ABORT, FW_CONFIRM, FW_ACK, FW_NAK = 40, 41, 42, 43, 44, 45, 46

# FW update (main/fw_update.cpp). Chunk matches the device's 4 KiB USB rx ring.
FW_CHUNK = 4096
FW_BEGIN_TIMEOUT_S = 30.0   # esp_ota_begin erases the whole partition synchronously
FW_DATA_TIMEOUT_S = 5.0
FW_END_TIMEOUT_S = 15.0
FW_RETRIES = 5

# TX loop (main/cmd_tx.cpp): TxStartPayload, 0 in any field = device default/keep current
TX_START = struct.Struct(">IIIiI")  # intervalMs, burstCount, frameLen (random payload bytes), txPower dBm, datarate kbps
TX_MAX_INTERVAL_MS = 3600000
TX_MAX_BURST = 32                   # frames sent back-to-back per interval
TX_MAX_PAYLOAD = 1500 - 34          # WIFI_TX_MAX_FRAME_LEN - ITS header
TX_DATARATES = (3000, 4500, 6000, 9000, 12000, 18000, 24000, 27000)   # 802.11p 10 MHz, kbps

# ESP app image header (esp_app_format.h)
ESP_IMAGE_MAGIC = 0xE9
ESP_CHIP_ID_ESP32C5 = 0x0017
ESP_APP_DESC_MAGIC = 0xABCD5432
APP_DESC_OFF = 32           # esp_image_header_t(24) + first segment header(8)

CHANNELS = (5860, 5870, 5880, 5890, 5900, 5910, 5920)   # checkValidChannel() in obu_wifi.cpp
STATUS_CFG_KEYS = ("nodeid", "channel", "txpower", "sniffmode", "sniffms", "wifims",
                   "connmode", "loop", "led")

# Native USB-Serial-JTAG only; the CH9102 "UART" port carries the text console, not this protocol.
ESP_VID = 0x303A

INTERVAL_S = 2.0


class Device:
    def __init__(self, port: str):
        self.port = port
        self.ser: serial.Serial | None = None
        self.buf = bytearray()
        self.seq = 1
        self.on_rx = None       # callback(frame_len) for FRAME_RX
        self.on_cbr = None      # callback(payload) for CBR_IND
        self.on_pong = None     # callback(dict) for PONG

    def open(self, retry_s: float = 0.0):
        deadline = time.monotonic() + retry_s
        while True:
            try:
                ser = serial.Serial()
                ser.port = self.port
                ser.baudrate = 115200
                ser.timeout = 0.05
                # USB-Serial-JTAG resets on DTR=0/RTS=1. Linux asserts both at open and pyserial
                # applies DTR before RTS, so drop RTS first, then DTR, to never pass that state.
                ser.dtr = True
                ser.rts = False
                ser.open()
                ser.dtr = False
                self.ser = ser
                self.buf.clear()
                return
            except (serial.SerialException, OSError):
                if time.monotonic() >= deadline:
                    raise
                time.sleep(0.5)

    def close(self):
        if self.ser:
            try:
                self.ser.close()
            except Exception:
                pass
            self.ser = None

    def send(self, ftype: int, payload: bytes = b""):
        self.ser.write(COMM_HDR.pack(COMM_MAGIC, self.seq, ftype, len(payload)) + payload)
        self.seq = (self.seq + 1) & 0xFFFF or 1

    def poll(self, timeout: float) -> list[tuple[int, bytes]]:
        """Read for up to `timeout` s; dispatch async frames, return the rest."""
        out = []
        end = time.monotonic() + timeout
        while True:
            data = self.ser.read(self.ser.in_waiting or 1)
            if data:
                self.buf += data
                out += self._parse()
            if time.monotonic() >= end:
                return out

    def _parse(self) -> list[tuple[int, bytes]]:
        out = []
        while len(self.buf) >= COMM_HDR.size:
            magic, _seq, ftype, length = COMM_HDR.unpack_from(self.buf)
            if magic != COMM_MAGIC:
                # resync on next magic instead of dropping the whole buffer
                idx = self.buf.find(b"\x73\x84", 1)
                del self.buf[: idx if idx > 0 else len(self.buf) - 1]
                continue
            total = COMM_HDR.size + length
            if len(self.buf) < total:
                break
            payload = bytes(self.buf[COMM_HDR.size:total])
            del self.buf[:total]
            if ftype == FRAME_RX:
                if self.on_rx:
                    self.on_rx(max(0, len(payload) - COMM_FRAME_HDR_LEN))
            elif ftype == CBR_IND_FRAME and self.on_cbr:
                self.on_cbr(payload)
            elif ftype == PONG and self.on_pong:
                self.on_pong(_json(payload))
            elif ftype == PING:
                pass  # device boot-time ping
            else:
                out.append((ftype, payload))
        return out

    def request(self, ftype: int, payload: bytes, expect: tuple[int, ...], timeout: float = 1.0):
        """Send and wait for the first reply of a type in `expect`. Replies aren't
        correlated by the protocol, so callers must keep requests sequential."""
        self.send(ftype, payload)
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            for t, p in self.poll(0.05):
                if t in expect:
                    return t, p
        return None, None

    def fw_request(self, ftype: int, payload: bytes, timeout: float) -> tuple[int | None, int]:
        """FW_* request -> (FW_ACK|FW_NAK|None, FwAckPayload.value)."""
        t, p = self.request(ftype, payload, (FW_ACK, FW_NAK), timeout)
        if t is None or len(p) < 4:
            return None, 0
        return t, struct.unpack_from(">I", p)[0]

    def ping(self, timeout: float = 1.0) -> dict | None:
        result = []
        prev, self.on_pong = self.on_pong, result.append
        try:
            self.send(PING)
            end = time.monotonic() + timeout
            while not result and time.monotonic() < end:
                self.poll(0.05)
        finally:
            self.on_pong = prev
        return result[0] if result else None

    def cfg_get(self, key: str) -> str | None:
        t, p = self.request(CMD_CONFIG, f"CFG:{key}".encode(), (CMD_CONFIG, CMD_FAIL))
        # empty reply == key not set in NVS; string values carry their NUL terminator
        return p.decode(errors="replace").rstrip("\x00").strip() if t == CMD_CONFIG else None

    def cfg_set(self, key: str, value) -> str | None:
        t, p = self.request(CMD_CONFIG, f"CFG:{key}={value}".encode(), (CMD_CONFIG, CMD_FAIL))
        return p.decode(errors="replace") if t == CMD_CONFIG else None

    def cbr_read(self) -> tuple[float, float, int, int] | None:
        result = []
        prev, self.on_cbr = self.on_cbr, result.append
        try:
            self.send(CMD_CBR_READ)
            end = time.monotonic() + 1.0
            while not result and time.monotonic() < end:
                self.poll(0.05)
        finally:
            self.on_cbr = prev
        return decode_cbr(result[0]) if result else None

    def stream(self, on: bool) -> bool:
        t, _ = self.request(CMD_START if on else CMD_STOP, b"USB", (CMD_GOOD, CMD_FAIL))
        return t == CMD_GOOD


def _json(payload: bytes) -> dict:
    try:
        return json.loads(payload.decode(errors="replace"))
    except ValueError:
        return {"raw": payload.decode(errors="replace")}


def decode_cbr(payload: bytes):
    if len(payload) < CBR_IND.size:
        return None
    avg, latest, valid, rejected = CBR_IND.unpack_from(payload)
    return avg / 1000.0, latest / 1000.0, valid, rejected


def find_port() -> str | None:
    for p in serial.tools.list_ports.comports():
        if p.vid == ESP_VID:
            return p.device
    return None


# ── commands ─────────────────────────────────────────────────────────────────

def cmd_status(dev: Device) -> int:
    pong = dev.ping()
    if pong is None:
        print("no PONG from device (wrong port? use the native 'USB' port, not 'UART')")
        return 1
    print(f"port        : {dev.port}")
    print(f"fw version  : {pong.get('version', '?')}")
    for k in ("rx", "rxErr", "tx", "txErr"):
        if k in pong:
            print(f"{k:<12}: {pong[k]}")
    for k in STATUS_CFG_KEYS:
        v = dev.cfg_get(k)
        print(f"{k:<12}: {v or '-'}")
    cbr = dev.cbr_read()
    if cbr is None:
        print("cbr         : no reply")
    elif cbr[2] == 0:
        print("cbr         : no window measured yet")
    else:
        print(f"cbr         : avg {cbr[0]:.1f}%  latest {cbr[1]:.1f}%  "
              f"(valid {cbr[2]}, rejected {cbr[3]})")
    return 0


def reboot_reconnect(dev: Device) -> dict | None:
    """CMD_REBOOT, reopen the port (re-enumerates on USB), wait for PONG."""
    dev.request(CMD_REBOOT, b"", (CMD_GOOD,), timeout=1.0)
    dev.close()
    time.sleep(1.5)
    try:
        dev.open(retry_s=15.0)
    except (serial.SerialException, OSError) as e:
        print(f"reconnect failed: {e}")
        return None
    # boot takes a moment before the USB rx task answers
    end = time.monotonic() + 15.0
    while time.monotonic() < end:
        pong = dev.ping(timeout=0.5)
        if pong is not None:
            return pong
    print("device did not answer after reboot")
    return None


def read_image(path: str) -> tuple[bytes, str]:
    """Load an app image and sanity-check its header (esp_app_format.h)."""
    with open(path, "rb") as f:
        img = f.read()
    if len(img) < APP_DESC_OFF + 112 or img[0] != ESP_IMAGE_MAGIC:
        raise ValueError("not an ESP app image (bad magic)")
    chip_id = struct.unpack_from("<H", img, 12)[0]
    if chip_id != ESP_CHIP_ID_ESP32C5:
        raise ValueError(f"image is for chip id {chip_id}, not ESP32-C5 ({ESP_CHIP_ID_ESP32C5})")
    if struct.unpack_from("<I", img, APP_DESC_OFF)[0] != ESP_APP_DESC_MAGIC:
        raise ValueError("no app descriptor (bootloader or partition table bin?)")
    version = img[APP_DESC_OFF + 16:APP_DESC_OFF + 48].split(b"\0")[0].decode(errors="replace")
    project = img[APP_DESC_OFF + 48:APP_DESC_OFF + 80].split(b"\0")[0].decode(errors="replace")
    return img, f"{project} {version}"


def cmd_flash(dev: Device, path: str) -> int:
    try:
        img, desc = read_image(path)
    except (OSError, ValueError) as e:
        print(f"{path}: {e}")
        return 1
    total = len(img)
    print(f"image: {desc}, {total} bytes")

    # clear a stale session (e.g. previous run killed mid-transfer); always ACKed
    dev.request(FW_ABORT, b"", (FW_ACK, FW_NAK))

    print("erasing target partition ...")
    t, v = dev.fw_request(FW_BEGIN, struct.pack(">I", total), FW_BEGIN_TIMEOUT_S)
    if t != FW_ACK:
        print(f"FW_BEGIN rejected ({'timeout' if t is None else f'NAK {v}'})")
        return 1

    offset = 0
    retries = 0
    start = time.monotonic()
    try:
        while offset < total:
            chunk = img[offset:offset + FW_CHUNK]
            t, v = dev.fw_request(FW_DATA, struct.pack(">I", offset) + chunk, FW_DATA_TIMEOUT_S)
            if t == FW_ACK:
                offset = v
                retries = 0
            elif t == FW_NAK and v == 0 and offset != 0:
                # 0 means the session died (write error / idle abort), not an offset resync
                print(f"\ndevice aborted transfer at {offset}")
                return 1
            else:
                retries += 1
                if retries > FW_RETRIES:
                    print(f"\ntransfer failed at {offset} ({'timeout' if t is None else 'NAK'})")
                    dev.request(FW_ABORT, b"", (FW_ACK, FW_NAK))
                    return 1
                if t == FW_NAK:
                    offset = v  # device's written count == next expected offset
            dt = max(time.monotonic() - start, 1e-3)
            sys.stdout.write(f"\rflash: {offset * 100 // total:3d}%  {offset}/{total}  "
                             f"{offset / dt / 1024:6.1f} KiB/s")
            sys.stdout.flush()
    except KeyboardInterrupt:
        print("\naborting ...")
        dev.request(FW_ABORT, b"", (FW_ACK, FW_NAK))
        raise
    print()

    # esp_ota_end verifies the whole image before switching the boot partition
    t, v = dev.fw_request(FW_END, b"", FW_END_TIMEOUT_S)
    if t != FW_ACK:
        print(f"FW_END rejected ({'timeout' if t is None else f'NAK {v}'}), boot partition unchanged")
        return 1

    print("image verified, rebooting into new firmware ...")
    pong = reboot_reconnect(dev)
    if pong is None:
        print("new firmware not confirmed; bootloader rolls back if it never comes up")
        return 1
    # cancels the anti-brick rollback timer (see docs/design_notes.md, OTA)
    t, _ = dev.fw_request(FW_CONFIRM, b"", 2.0)
    if t != FW_ACK:
        print("FW_CONFIRM failed; device may roll back")
        return 1
    print(f"firmware running and confirmed (protocol version {pong.get('version', '?')})")
    return 0


def cmd_chan(dev: Device, chan: int) -> int:
    cur = dev.cfg_get("channel")
    if cur is not None and cur.strip() == str(chan):
        print(f"channel already {chan} MHz")
        return 0
    if dev.cfg_set("channel", chan) is None:
        print(f"setting channel {chan} failed")
        return 1
    # Firmware applies the channel only at boot (WifiController::autostart), so reboot.
    print(f"channel set to {chan} MHz, rebooting device ...")
    if reboot_reconnect(dev) is None:
        return 1
    now = dev.cfg_get("channel")
    if now is None or now.strip() != str(chan):
        print(f"verify failed: device reports channel {now}")
        return 1
    print(f"tuned to {chan} MHz")
    return 0


def tx_start(dev: Device, interval: int, burst: int, length: int, power: int, datarate: int) -> bool:
    t, _ = dev.request(TX_LOOP_START, TX_START.pack(interval, burst, length, power, datarate),
                       (CMD_GOOD, CMD_FAIL))
    if t != CMD_GOOD:
        print("TX_LOOP_START " + ("rejected (out of range)" if t == CMD_FAIL
                                  else "got no reply (FW without TX loop?)"))
        return False
    return True


def tx_status(dev: Device) -> dict | None:
    t, p = dev.request(TX_LOOP_STATUS, b"", (TX_LOOP_STATUS,))
    return _json(p) if t == TX_LOOP_STATUS else None


def cmd_monitor(dev: Device, rx: bool, with_cbr: bool, tx: tuple[int, int, int, int, int] | None) -> int:
    """One self-overwriting status line every INTERVAL_S for RX and/or TX until Ctrl-C."""
    frames = 0
    nbytes = 0

    def on_rx(n):
        nonlocal frames, nbytes
        frames += 1
        nbytes += n

    if rx:
        dev.on_rx = on_rx
        if not dev.stream(True):
            print("CMD_START USB failed")
            return 1
    if tx is not None and not tx_start(dev, *tx):
        if rx:
            dev.stream(False)
        return 1
    last = time.monotonic()
    width = 0
    try:
        while True:
            dev.poll(0.1)
            now = time.monotonic()
            if now - last < INTERVAL_S:
                continue
            dt = now - last
            last = now
            parts = []
            if rx:
                parts.append(f"RX: {frames / dt:7.1f} fps {nbytes / dt:9.0f} B/s")
                frames = nbytes = 0
                if with_cbr:
                    cbr = dev.cbr_read()
                    if cbr is None:
                        parts.append("CBR:   n/a")
                    elif cbr[2] == 0:
                        parts.append("CBR:  wait")
                    else:
                        parts.append(f"CBR: {cbr[0]:5.1f}%")
            if tx is not None:
                st = tx_status(dev)
                if st is None:
                    parts.append("TX: n/a")
                else:
                    parts.append(f"TX: {float(st.get('fps', 0)):7.1f} fps "
                                 f"{float(st.get('bps', 0)):9.0f} B/s  len {st.get('len', '?')}  "
                                 f"burst {st.get('burst', '?')}  "
                                 f"err {st.get('err', '?')}")
            # PING doubles as keepalive: the device drops its coex hold after 30 s of host silence
            dev.send(PING)
            line = "  ".join(parts)
            width = max(width, len(line))
            sys.stdout.write("\r" + line.ljust(width))
            sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\n")
        try:
            if tx is not None:
                dev.request(TX_LOOP_STOP, b"", (CMD_GOOD, CMD_FAIL))
            if rx:
                dev.stream(False)
        except Exception:
            pass
    return 0


def _int_range(lo: int, hi: int):
    def conv(v: str) -> int:
        n = int(v, 0)
        if not lo <= n <= hi:
            raise argparse.ArgumentTypeError(f"must be {lo}..{hi}")
        return n
    return conv


def main() -> int:
    p = argparse.ArgumentParser(
        prog="esp32-test",
        description="Quick evaluation/test of the ESP32-C5 OBU via the obu_comm USB protocol.",
        epilog="examples:\n"
               "  esp32-test --status\n"
               "  esp32-test --chan 5880 --rx --cbr\n"
               "  esp32-test --port COM7 --rx\n"
               "  esp32-test --flash cmake-build-esp32c5/obu-esp32-c5.bin\n"
               "  esp32-test --tx --tx-interval 10 --tx-length 300 --tx-power 20\n"
               "  esp32-test --tx --tx-interval 100 --tx-burst 8",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--status", action="store_true", help="print FW version, counters, config, CBR")
    p.add_argument("--rx", action="store_true",
                   help="print received frames/s and bytes/s every 2 s until Ctrl-C (combinable with --tx)")
    p.add_argument("--cbr", action="store_true", help="also print CBR (implies --rx)")
    p.add_argument("--tx", action="store_true",
                   help="start TX test loop, print TX status every 2 s until Ctrl-C (stops loop)")
    p.add_argument("--tx-interval", type=_int_range(1, TX_MAX_INTERVAL_MS), metavar="MS",
                   help="ms between frames (default 1000; 10 ms granularity); implies --tx")
    p.add_argument("--tx-burst", type=_int_range(1, TX_MAX_BURST), metavar="N",
                   help=f"frames sent back-to-back per interval, 1..{TX_MAX_BURST} "
                        "(default: device current, 1 at boot); implies --tx")
    p.add_argument("--tx-length", type=_int_range(0, TX_MAX_PAYLOAD), metavar="BYTES",
                   help=f"random payload bytes after the 34-byte header, 0..{TX_MAX_PAYLOAD} "
                        "(default: device current, 128 at boot); implies --tx")
    p.add_argument("--tx-datarate", type=int, choices=TX_DATARATES, metavar="KBPS",
                   help=f"datarate in kbps, one of {', '.join(map(str, TX_DATARATES))}; implies --tx")
    p.add_argument("--tx-power", type=_int_range(2, 20), metavar="DBM",
                   help="TX power 2..20 dBm; implies --tx")
    p.add_argument("--chan", type=int, metavar="MHZ", choices=CHANNELS,
                   help=f"tune to channel ({CHANNELS[0]}..{CHANNELS[-1]}, 10 MHz steps); "
                        "stored as autostart channel, device reboots")
    p.add_argument("--flash", metavar="BIN",
                   help="FW update with an app image (e.g. cmake-build-esp32c5/obu-esp32-c5.bin); "
                        "reboots and confirms the new FW")
    p.add_argument("--port", help="serial port (e.g. COM7, /dev/ttyACM0); default: auto-detect")
    p.add_argument("--list-ports", action="store_true", help="list serial ports and exit")

    if len(sys.argv) == 1:
        p.print_help()
        return 0
    args = p.parse_args()

    if args.list_ports:
        for pt in serial.tools.list_ports.comports():
            vid_pid = f" [{pt.vid:04X}:{pt.pid:04X}]" if pt.vid else ""
            print(f"{pt.device:<14} {pt.description}{vid_pid}")
        return 0

    tx_tune = (args.tx_interval, args.tx_burst, args.tx_length, args.tx_power, args.tx_datarate)
    args.tx = args.tx or any(v is not None for v in tx_tune)
    if not (args.status or args.rx or args.cbr or args.chan or args.flash or args.tx):
        p.print_help()
        return 0

    port = args.port or find_port()
    if not port:
        print("no ESP32 USB-Serial-JTAG port found; connect the 'USB' port or pass --port")
        return 1

    dev = Device(port)
    try:
        dev.open()
    except (serial.SerialException, OSError) as e:
        print(f"cannot open {port}: {e}")
        return 1

    try:
        rc = 0
        if args.flash:
            rc = cmd_flash(dev, args.flash)
        if rc == 0 and args.chan:
            rc = cmd_chan(dev, args.chan)
        if rc == 0 and args.status:
            rc = cmd_status(dev)
        if rc == 0 and (args.rx or args.cbr or args.tx):
            # 0 = device default/keep current, see TxStartPayload
            tx = tuple(v or 0 for v in tx_tune) if args.tx else None
            rc = cmd_monitor(dev, args.rx or args.cbr, args.cbr, tx)
        return rc
    except KeyboardInterrupt:
        return 130
    finally:
        dev.close()


if __name__ == "__main__":
    sys.exit(main())
